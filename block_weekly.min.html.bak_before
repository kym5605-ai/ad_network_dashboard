3],[985552,13],[650448,13],[843542,13],[1255550,13]],"l":[null,null,null,null,null,null,null,null,null,null,null,null,[49390084,96957144],[85334203,119025408],[136177487,184011750],[68072235,72811612],[49377496,64366913],[71806824,77073272],[45370734,50026614],[56260291,53388295],[73116177,54113519]]},"eod":{"est":158965589,"act":83790841,"ym":"2026-09","e":13,"Dm":30,"last":"2026-09-13","fallback":false,"dropped":[]}};
const GK=['커뮤니티 네이티브','커뮤니티 보드','게시글 하단','검색 지면','연합게시판(신규)'];
const NK=Object.keys(W.n);
const NW=W.w.length;
W.wkEnd=(()=>{let y=+W.y0,pm=0,out=[];W.w.forEach(s=>{const m=+s.slice(0,2);if(m<pm)y++;pm=m;out.push(y+'-'+s);});return out;})();
W.grp=W.g; W.net=W.n;
W.dau=W.ku.map(v=>v*1000);
W.dd=W.dd.map(v=>v*100); W.du=W.du.map(v=>v*100); W.di=(W.di||[]).map(v=>v*1000);
const KI={'수익':0,'노출수':1,'요청수':2,'응답수':3}, KM=[1,1000,1000,1000];
let cur=NW-1;
const span=12;
const ymd=d=>d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
const f0=n=>Math.round(n).toLocaleString();
const man=v=>Math.round(v/10000).toLocaleString()+'만';
const pct=(a,b)=>b?((a/b-1)*100):null;
const sp=v=>v==null?'<span style="color:#8A9099">—</span>'
:`<span class="${v>=0?'up':'dn'}">${v>=0?'+':''}${v.toFixed(1)}%</span>`;
const S=(o,k,i)=>(o[KI[k]][i]||0)*KM[KI[k]];
const ec=(o,i)=>S(o,'노출수',i)?S(o,'수익',i)/S(o,'노출수',i)*1000:0;
const fr=(o,i)=>S(o,'요청수',i)?S(o,'응답수',i)/S(o,'요청수',i)*100:0;
const ir=(o,i)=>S(o,'요청수',i)?S(o,'노출수',i)/S(o,'요청수',i):0;
function chart(el,arr,opt){
const o=Object.assign({W:900,H:230,col:'#D9873F',fmt:f0,lab:[],step:2,area:true,dim:null,multi:null,daily:true,name:'값',proj:false,live:false},opt);
const P={l:64,r:36,t:16,b:30},n=arr?arr.length:o.multi[0][1].length;
const X=i=>P.l+i*(o.W-P.l-P.r)/(n-1||1);
let vals=[];
if(o.multi) vals=o.multi.flatMap(m=>m[1]).filter(v=>v!=null);
else{ if(o.daily) vals=vals.concat(arr.filter(v=>v!=null));
if(o.dim) vals=vals.concat(o.dim.filter(v=>v!=null));
if(!vals.length) vals=arr.filter(v=>v!=null); }
let mx=Math.max(...vals)*1.1||1,mn=0;
if(o.multi){mn=Math.min(...vals)*0.95;mx=Math.max(...vals)*1.05;}
const Y=v=>o.H-P.b-((v-mn)/((mx-mn)||1))*(o.H-P.t-P.b);
let g='';
for(let t=0;t<=4;t++){const v=mn+(mx-mn)*t/4,y=Y(v);
g+=`<line x1="${P.l}" y1="${y}" x2="${o.W-P.r}" y2="${y}" stroke="rgba(0,0,0,.08)"/>`
+`<text x="${P.l-8}" y="${y+4}" text-anchor="end" fill="#8A9099" font-size="10.5">${o.fmt(v)}</text>`;}
const mk=(a,c,w,op)=>{let d='',pen=false;a.forEach((v,i)=>{if(v==null){pen=false;return;}
d+=(pen?'L':'M')+X(i).toFixed(1)+' '+Y(v).toFixed(1)+' ';pen=true;});
return `<path d="${d}" fill="none" stroke="${c}" stroke-width="${w}" stroke-linejoin="round" opacity="${op}"/>`;};
if(o.multi){o.multi.forEach(m=>g+=mk(m[1],m[2],2,1));}
else{
if(o.area){const p=arr.slice(0,o.proj?n-1:n).map((v,i)=>[X(i),Y(v)]);
const d=p.map((q,i)=>(i?'L':'M')+q[0].toFixed(1)+' '+q[1].toFixed(1)).join(' ');
const id='g'+Math.random().toString(36).slice(2,7);
g+=`<defs><linearGradient id="${id}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${o.col}" stop-opacity=".18"/><stop offset="1" stop-color="${o.col}" stop-opacity="0"/></linearGradient></defs>`
+`<path d="${d} L${p[p.length-1][0].toFixed(1)} ${o.H-P.b} L${p[0][0].toFixed(1)} ${o.H-P.b} Z" fill="url(#${id})"/>`;}
if(o.dim)g+=mk(o.dim,'#B6C8D8',2.2,1);
if(o.daily)g+=mk(o.proj?arr.map((v,i)=>i===n-1?null:v):arr,o.col,o.area?2.2:1.6,1);
if(o.proj&&n>1)g+=`<path d="M${X(n-2).toFixed(1)} ${Y(arr[n-2]).toFixed(1)} L${X(n-1).toFixed(1)} ${Y(arr[n-1]).toFixed(1)}" fill="none" stroke="${o.col}" stroke-width="2.2" stroke-dasharray="5 4" opacity=".75"/>`;
if(o.daily&&o.area&&n<=30)arr.forEach((v,i)=>{
const hollow=(o.proj||o.live)&&i===n-1;
g+=`<circle cx="${X(i).toFixed(1)}" cy="${Y(v).toFixed(1)}" r="${i===n-1?4:2.6}" fill="${hollow?'#fff':o.col}"${hollow?` stroke="${o.col}" stroke-width="2"`:''}/>`;
if(n<=14&&(i%2===1||i===n-1))g+=`<text x="${X(i).toFixed(1)}" y="${(Y(v)-10).toFixed(1)}" text-anchor="${i===n-1?'end':'middle'}" fill="#5A6169" font-size="10.5">${o.fmt(v)}</text>`;});
}
o.lab.forEach((l,i)=>{if((n-1-i)%o.step===0)
g+=`<text x="${X(i)}" y="${o.H-11}" text-anchor="middle" fill="#8A9099" font-size="10.5">${l}</text>`;});
const SER=[];
if(o.multi)o.multi.forEach(m=>SER.push({name:m[0],vals:m[1],col:m[2]}));
else{
if(o.daily)SER.push({name:o.dim?'일별':o.name,vals:arr,col:o.col});
if(o.dim)SER.push({name:'7일 평균',vals:o.dim,col:'#B6C8D8'});
if(!SER.length)SER.push({name:o.name,vals:arr,col:o.col});
}
g+=`<line class="gl" x1="0" y1="${P.t-6}" x2="0" y2="${o.H-P.b}"/>`;
SER.forEach(sr=>g+=`<circle class="hp" r="4.2" fill="#fff" stroke="${sr.col}" stroke-width="2.3"/>`);
g+=`<rect x="0" y="0" width="${o.W}" height="${o.H}" fill="transparent"/>`;
el.innerHTML=`<div class="ch"><svg width="100%" viewBox="0 0 ${o.W} ${o.H}" style="max-width:100%">${g}</svg><div class="tt"></div></div>`;
const svg=el.querySelector('svg'),tt=el.querySelector('.tt'),
gl=svg.querySelector('.gl'),hp=[...svg.querySelectorAll('.hp')];
const hide=()=>{tt.style.opacity=0;gl.style.opacity=0;hp.forEach(c=>c.style.opacity=0);};
svg.addEventListener('pointermove',ev=>{
const r=svg.getBoundingClientRect();if(!r.width)return;
const sx=(ev.clientX-r.left)/r.width*o.W;
const stp=(o.W-P.l-P.r)/(n-1||1);
let i=Math.round((sx-P.l)/stp);i=Math.max(0,Math.min(n-1,i));
const gx=X(i);let rows='',ys=[];
SER.forEach((sr,k)=>{const v=sr.vals?sr.vals[i]:null;
if(v==null){hp[k].style.opacity=0;return;}
hp[k].setAttribute('cx',gx.toFixed(1));hp[k].setAttribute('cy',Y(v).toFixed(1));hp[k].style.opacity=1;ys.push(Y(v));
rows+=`<div class="r"><i style="background:${sr.col}"></i>${sr.name}<b>${o.fmt(v)}</b></div>`;});
if(!rows){hide();return;}
gl.setAttribute('x1',gx.toFixed(1));gl.setAttribute('x2',gx.toFixed(1));gl.style.opacity=1;
tt.innerHTML=`<div class="d">${o.lab[i]!=null?o.lab[i]:''}</div>${rows}`;
const px=gx/o.W*r.width, py=Math.min(...ys)/o.H*r.height;
tt.style.opacity=1;
const tw=tt.offsetWidth||120;
tt.style.left=Math.max(tw/2+2,Math.min(r.width-tw/2-2,px))+'px';
tt.style.top=Math.max(tt.offsetHeight+4,py-9)+'px';
});
svg.addEventListener('pointerleave',hide);
svg.addEventListener('pointercancel',hide);
}
function tiles(){
const T=W.grp['합계'],i=cur,p=cur-1,y=cur-52;
const rv=S(T,'수익',i),im=S(T,'노출수',i);
const g=(o,fn)=>[fn(o,i),p>=0?fn(o,p):null,y>=0?fn(o,y):null];
const rev=g(T,(o,x)=>S(o,'수익',x)),imp=g(T,(o,x)=>S(o,'노출수',x));
const e=g(T,ec),f=g(T,fr);
const du=[W.dau[i],p>=0?W.dau[p]:null,y>=0?W.dau[y]:null];
const ar=du.map((v,x)=>v?[rev[0],rev[1],rev[2]][x]/7/v:null);
const T6=[['주간 매출',man(rev[0])+'원',rev],['앱 DAU',(du[0]/10000).toFixed(1)+'만',du],
['ARPDAU','₩'+(ar[0]||0).toFixed(2),ar],['eCPM',Math.round(e[0])+'원',e],
['Fill Rate',f[0].toFixed(1)+'%',f],['노출수',(imp[0]/1e8).toFixed(2)+'억',imp]];
document.getElementById('tiles').innerHTML=T6.map(t=>
`<div class="tile"><div class="k">${t[0]}</div><div class="v">${t[1]}</div>
<div class="n">WoW ${sp(pct(t[2][0],t[2][1]))} · YoY ${sp(pct(t[2][0],t[2][2]))}</div></div>`).join('');
const e0=W.wkEnd[i],st=new Date(e0+'T00:00:00');st.setDate(st.getDate()-6);
document.getElementById('period').textContent=
`${ymd(st)} (월) ~ ${e0} (일) · 전주 ${p>=0?W.wkEnd[p]:'—'} 마감주 · 전년 ${y>=0?W.wkEnd[y]:'데이터 없음'} 마감주`;
}
const MET=[['수익','매출','#D9873F',v=>man(v)],['ecpm','eCPM','#2FA36B',v=>Math.round(v)+'원'],['fr','Fill Rate','#3987E5',v=>v.toFixed(1)+'%']];
function seriesOf(o,key,a,b){const out=[];for(let i=a;i<=b;i++)
out.push(key==='ecpm'?ec(o,i):key==='fr'?fr(o,i):S(o,key,i));return out;}
function win(){const b=cur,a=span?Math.max(0,cur-span+1):0;return [a,b];}
function labs(a,b){const L=[];for(let i=a;i<=b;i++){const t=W.wkEnd[i];L.push(t.slice(5).replace('-','/'));}return L;}
function row(name,o,src){
const i=cur,p=cur-1,y=cur-52;
return `<tr class="hd" data-k="${name}" data-s="${src}"><td><span>▸</span></td><td>${name}</td>
<td>${f0(S(o,'수익',i))}</td><td>${ec(o,i).toFixed(1)}</td><td>${fr(o,i).toFixed(1)}%</td>
<td>${sp(p>=0?pct(S(o,'수익',i),S(o,'수익',p)):null)}</td>
<td>${y>=0&&S(o,'수익',y)>0?sp(pct(S(o,'수익',i),S(o,'수익',y))):'<span style="color:#8A9099">신규</span>'}</td></tr>`;
}
function totRow(){
const T=W.grp['합계'],i=cur,p=cur-1,y=cur-52;
return `<tr class="tot hd" data-k="합계" data-s="grp"><td><span>▸</span></td><td>합계</td>
<td>${f0(S(T,'수익',i))}</td><td>${ec(T,i).toFixed(1)}</td><td>${fr(T,i).toFixed(1)}%</td>
<td>${sp(p>=0?pct(S(T,'수익',i),S(T,'수익',p)):null)}</td>
<td>${y>=0&&S(T,'수익',y)>0?sp(pct(S(T,'수익',i),S(T,'수익',y))):'—'}</td></tr>`;
}
function fill(){
document.getElementById('tG').innerHTML=GK.map(k=>row(k,W.grp[k],'grp')).join('')+totRow();
document.getElementById('tN').innerHTML=NK.map(k=>row(k,W.net[k],'net')).join('')+totRow();
document.querySelectorAll('tr.hd').forEach(tr=>tr.onclick=()=>expand(tr));
}
function expand(tr){
const nx=tr.nextElementSibling;
if(nx&&nx.classList.contains('ex')){nx.remove();tr.classList.remove('op');return;}
document.querySelectorAll('tr.ex').forEach(r=>r.remove());
document.querySelectorAll('tr.hd.op').forEach(r=>r.classList.remove('op'));
tr.classList.add('op');
const key=tr.dataset.k,src=tr.dataset.s,o=W[src][key];
const r=document.createElement('tr');r.className='ex';
r.innerHTML=`<td colspan="7"><div class="exb"><div class="exh"><span class="t">${key}</span>
<span class="grp">${MET.map((m,i)=>`<button class="pill${i?'':' on'}" data-m="${m[0]}">${m[1]}</button>`).join('')}</span></div>
<div class="bc"></div><div class="st"></div></div></td>`;
tr.after(r);
const bc=r.querySelector('.bc'),stx=r.querySelector('.st');
const draw=mk=>{const [a,b]=win(),arr=seriesOf(o,mk,a,b),M=MET.find(x=>x[0]===mk);
const L=labs(a,b),n=arr.length;
chart(bc,arr,{W:880,H:235,col:M[2],fmt:M[3],lab:L,step:Math.max(1,Math.round(n/7)),area:true,name:`${key} ${M[1]}`});
const last=arr[n-1],prev=arr[n-2],first=arr[0],pos=arr.filter(v=>v>0);
stx.innerHTML=`<span>최근 <b>${M[3](last)}</b></span><span>전주 대비 ${sp(pct(last,prev))}</span>
<span>${n}주 전 대비 ${sp(pct(last,first))}</span>
<span>최고 <b>${M[3](Math.max(...arr))}</b> · 최저 <b>${M[3](pos.length?Math.min(...pos):0)}</b></span>`;};
let curM='수익';
draw(curM);
r.querySelectorAll('.exh .pill[data-m]').forEach(b=>b.onclick=e=>{e.stopPropagation();
r.querySelectorAll('.exh .pill[data-m]').forEach(x=>x.classList.remove('on'));b.classList.add('on');curM=b.dataset.m;draw(curM);});
}
function dec(o,i,p){
const q0=S(o,'요청수',p),q1=S(o,'요청수',i),f_0=ir(o,p),f_1=ir(o,i),e0=ec(o,p),e1=ec(o,i);
return {dq:(q1-q0)*f_0*e0/1000, df:q1*(f_1-f_0)*e0/1000, de:q1*f_1*(e1-e0)/1000,
q0,q1,f0:f_0*100,f1:f_1*100,e0,e1, d:S(o,'수익',i)-S(o,'수익',p)};
}
function drawLever(){
const i=cur,p=cur-1;
if(p<0){document.getElementById('lever').innerHTML='<p class="sub">전주 데이터가 없어 분해할 수 없습니다.</p>';
document.getElementById('factors').innerHTML='';document.getElementById('tL').innerHTML='';return;}
const rows=GK.map(k=>[k,dec(W.grp[k],i,p)]);
const A=dec(W.grp['합계'],i,p);
// 합계는 그룹 분해의 합으로 맞춘다(표 내부 정합성). 총계 수준 분해와의 차이는 지면 믹스 효과.
const T={dq:0,df:0,de:0,d:0,q0:A.q0,q1:A.q1,f0:A.f0,f1:A.f1,e0:A.e0,e1:A.e1};
rows.forEach(([,x])=>{T.dq+=x.dq;T.df+=x.df;T.de+=x.de;T.d+=x.d;});
const L=[['요청수',T.dq,'#1F8B5F'],['게재율',T.df,'#8A9099'],['eCPM',T.de,'#CC4B3E']];
const Wd=900,H=140,BH=28,GP=12,TP=12,NM=100,Z=400,RG=Wd-190;
const mx=Math.max(...L.map(r=>Math.abs(r[1])))||1;
let g=`<line x1="${Z}" y1="${TP-6}" x2="${Z}" y2="${H-8}" stroke="rgba(0,0,0,.2)"/>`;
L.forEach((r,k)=>{const y=TP+k*(BH+GP),ps=r[1]>=0;
const w=Math.abs(r[1])/mx*(ps?RG-Z:Z-NM-80),x=ps?Z:Z-w;
g+=`<text x="${NM}" y="${y+BH/2+5}" text-anchor="end" fill="#5A6169" font-size="12.5">${r[0]}</text>`
+`<rect x="${x.toFixed(1)}" y="${y}" width="${Math.max(w,3).toFixed(1)}" height="${BH}" rx="3" fill="${r[2]}" opacity=".84"/>`
+`<text x="${(ps?Z+w+9:x-9).toFixed(1)}" y="${y+BH/2+5}" text-anchor="${ps?'start':'end'}" fill="${r[2]}" font-size="13" font-weight="650">${ps?'+':'-'}${Math.abs(Math.round(r[1]/10000)).toLocaleString()}만원</text>`;});
const y=TP+3*(BH+GP)+4;
g+=`<line x1="${NM-60}" y1="${y-6}" x2="${RG+130}" y2="${y-6}" stroke="rgba(0,0,0,.12)"/>`
+`<text x="${NM}" y="${y+16}" text-anchor="end" fill="#1F2328" font-size="12.5" font-weight="660">합계</text>`
+`<text x="${Z+9}" y="${y+17}" fill="#1F2328" font-size="14.5" font-weight="700">${T.d>=0?'+':'-'}${Math.abs(Math.round(T.d/10000)).toLocaleString()}만원</text>`;
document.getElementById('lever').innerHTML=`<svg width="100%" viewBox="0 0 ${Wd} ${H+28}" style="max-width:100%">${g}</svg>`;
const sorted=rows.slice().sort((a,b)=>Math.abs(b[1].d)-Math.abs(a[1].d));
const big=sorted[0],worst=rows.slice().sort((a,b)=>a[1].de-b[1].de)[0];
const C=[
{n:'요인 1',c:'#1F8B5F',t:'트래픽(요청수) 변화',v:(T.dq>=0?'+':'-')+Math.abs(Math.round(T.dq/10000)).toLocaleString()+'만원',
p:`전체 요청수 ${(T.q0/1e8).toFixed(2)}억 → ${(T.q1/1e8).toFixed(2)}억 (${(pct(T.q1,T.q0)||0).toFixed(1)}%), 앱 DAU ${(W.dau[p]/10000).toFixed(1)}만 → ${(W.dau[i]/10000).toFixed(1)}만. 지면 그룹 중 ${big[0]}가 ${(big[1].dq>=0?'+':'')+Math.round(big[1].dq/10000).toLocaleString()}만원으로 가장 크게 기여했습니다.`},
{n:'요인 2',c:'#C87A2E',t:'단가(eCPM) 변화',v:(T.de>=0?'+':'-')+Math.abs(Math.round(T.de/10000)).toLocaleString()+'만원',
p:`전체 eCPM ${Math.round(T.e0)}원 → ${Math.round(T.e1)}원 (${(pct(T.e1,T.e0)||0).toFixed(1)}%). ${worst[0]}의 단가 영향이 ${Math.round(worst[1].de/10000).toLocaleString()}만원으로 가장 큽니다 (${Math.round(worst[1].e0)}원 → ${Math.round(worst[1].e1)}원).`},
{n:'요인 3',c:'#3987E5',t:'게재율 변화',v:(T.df>=0?'+':'-')+Math.abs(Math.round(T.df/10000)).toLocaleString()+'만원',
p:`전체 게재율 ${T.f0.toFixed(1)}% → ${T.f1.toFixed(1)}%. 요청이 늘어도 채우지 못하면 여기서 손실이 납니다.`}];
document.getElementById('factors').innerHTML=C.map(x=>
`<div class="fc"><div class="n" style="color:${x.c}">${x.n}</div><h5>${x.t}</h5>
<div class="v" style="color:${x.c}">${x.v}</div><p>${x.p}</p></div>`).join('');
const cc=v=>`<span class="${v>=0?'up':'dn'}">${v>=0?'+':'-'}${Math.abs(Math.round(v/10000)).toLocaleString()}만</span>`;
document.getElementById('tL').innerHTML=rows.map(([k,x])=>
`<tr><td></td><td>${k}</td><td><b>${cc(x.d)}</b></td><td>${cc(x.dq)}</td><td>${cc(x.df)}</td><td>${cc(x.de)}</td>
<td>${Math.round(x.e0)} → ${Math.round(x.e1)}원</td></tr>`).join('')
+`<tr class="tot"><td></td><td>합계</td><td>${cc(T.d)}</td><td>${cc(T.dq)}</td><td>${cc(T.df)}</td><td>${cc(T.de)}</td>
<td>${Math.round(T.e0)} → ${Math.round(T.e1)}원</td></tr>`;
}
let mIdx=MO.m.length-1, mTrend='rev', axis='m', mCmp='mom', mWin='m';
const mSpan=0;
const MLAST=MO.m.length-1;
const MCUR=()=>mIdx===MLAST;
const MP=()=>MCUR()?MO.M:MO.F;
const mv=(a,k)=>a?(a[k]||0)*(k?1000:1):0;
const mEc=a=>mv(a,1)?mv(a,0)/mv(a,1)*1000:0;
const mIr=a=>mv(a,2)?mv(a,1)/mv(a,2)*100:0;
const mLab=k=>k.slice(2).replace('-','/');
const mOff=()=>mCmp==='mom'?1:12;
const mDay=i=>(MP().d[i]&&MP().d[i][1])||1;
const mMis=(i,j)=>j>=0&&mDay(i)!==mDay(j);
const mSc=(i,j)=>mMis(i,j)?mDay(i)/mDay(j):1;
const cpct=(a,b,i,j)=>mMis(i,j)?pct(a/mDay(i),b/mDay(j)):pct(a,b);
const cdif=(a,b,i,j)=>a-b*mSc(i,j);
const won=v=>(v>=0?'+':'-')+Math.abs(Math.round(v/10000)).toLocaleString()+'만원';
function bars(el,L,tot){
const Wd=900,BH=28,GP=12,TP=12,NM=112,Z=418,RG=Wd-180,H=TP+L.length*(BH+GP)+34;
const mx=Math.max(...L.map(r=>Math.abs(r[1])))||1;
let g=`<line x1="${Z}" y1="${TP-6}" x2="${Z}" y2="${TP+L.length*(BH+GP)-6}" stroke="rgba(0,0,0,.2)"/>`;
L.forEach((r,k)=>{const y=TP+k*(BH+GP),ps=r[1]>=0;
const w=Math.abs(r[1])/mx*(ps?RG-Z:Z-NM-70),x=ps?Z:Z-w;
g+=`<text x="${NM}" y="${y+BH/2+5}" text-anchor="end" fill="#5A6169" font-size="12.5">${r[0]}</text>`
+`<rect x="${x.toFixed(1)}" y="${y}" width="${Math.max(w,3).toFixed(1)}" height="${BH}" rx="3" fill="${r[2]}" opacity=".84"/>`
+`<text x="${(ps?Z+w+9:x-9).toFixed(1)}" y="${y+BH/2+5}" text-anchor="${ps?'start':'end'}" fill="${r[2]}" font-size="13" font-weight="650">${won(r[1])}</text>`;});
const y=TP+L.length*(BH+GP)+4;
g+=`<line x1="${NM-70}" y1="${y-6}" x2="${RG+130}" y2="${y-6}" stroke="rgba(0,0,0,.12)"/>`
+`<text x="${NM}" y="${y+16}" text-anchor="end" fill="#1F2328" font-size="12.5" font-weight="660">합계</text>`
+`<text x="${Z+9}" y="${y+17}" fill="#1F2328" font-size="14.5" font-weight="700">${won(tot)}</text>`;
el.innerHTML=`<svg width="100%" viewBox="0 0 ${Wd} ${H}" style="max-width:100%">${g}</svg>`;
}
function mTiles(){
const P=MP(),i=mIdx,y=i-mOff(),CM=mCmp==='mom',lb=CM?'MoM':'YoY';
const c=P.t[i],b=y>=0?P.t[y]:null;
const dc=P.d[i],db=y>=0?P.d[y]:null;
const arp=(t,d)=>d&&d[0]&&d[1]?mv(t,0)/d[0]/d[1]:null;
const T=[['기간 매출',man(mv(c,0))+'원',cpct(mv(c,0),b?mv(b,0):0,i,y)],
['앱 DAU',(dc[0]/10000).toFixed(1)+'만',pct(dc[0],db?db[0]:0)],
['ARPDAU','₩'+(arp(c,dc)||0).toFixed(2),pct(arp(c,dc),arp(b,db))],
['eCPM',Math.round(mEc(c))+'원',pct(mEc(c),b?mEc(b):0)],
['게재율',mIr(c).toFixed(1)+'%',pct(mIr(c),b?mIr(b):0),b?(mIr(c)-mIr(b)):null],
['노출수',(mv(c,1)/1e8).toFixed(2)+'억',cpct(mv(c,1),b?mv(b,1):0,i,y)]];
let pj='';
if(MCUR()&&MO.eod&&MO.eod.est) pj=`<div class="pj">월마감 예상 <b>${man(MO.eod.est)}원</b></div>`;
document.getElementById('mTiles').innerHTML=T.map((t,ti)=>
`<div class="tile"><div class="k">${t[0]}</div><div class="v">${t[1]}</div>
<div class="n">${lb} ${sp(t[2])}${t[3]!=null?` <span style="color:#8A9099">(${t[3]>=0?'+':''}${t[3].toFixed(1)}%p)</span>`:''}</div>${ti===0?pj:''}</div>`).join('');
const mm=MO.m[i],py=y>=0?MO.m[y]:null,d=P.d[i][1],bd=y>=0?P.d[y][1]:0;
document.getElementById('mPeriod').textContent = MCUR()
? `${mm}-01 ~ ${MO.ls} (${d}일 누적) · 비교 대상 ${py||'—'}-01 ~ ${py||'—'}-${String(bd).padStart(2,'0')} 같은 ${bd}일 기준`
: `${mm} 한 달 전체 (${d}일) · 비교 대상 ${py||'데이터 없음'}${py?` (${bd}일)`:''}`;
// 일수 불일치 안내 — 합산 지표만 일평균으로 맞춘다
const an=document.getElementById('mAdjN');
if(mMis(i,y)){an.style.display='';
an.innerHTML=`<b>일수 보정</b> — 두 기간의 일수가 다릅니다(${d}일 vs ${bd}일). 매출·노출수 같은 합산 지표의 증감률은 <b>일평균 기준</b>으로 맞춰 계산했습니다. eCPM·게재율·DAU·ARPDAU는 일수에 중립이라 그대로입니다. 아래 증감 분해는 누적 실적 차이 그대로입니다.`;}
else an.style.display='none';
// 동일 지면 비교 — 전년 대비 축에서만 의미가 있다
const L=P.l[i],el=document.getElementById('mLfl');
if(!CM&&L&&L[1]&&b){
const lf=(L[0]/L[1]-1)*100, tot=pct(mv(c,0),mv(b,0)), nw=mv(c,0)-L[0];
el.style.display='';
el.innerHTML=`<b>동일 지면 기준</b> — 전체 매출은 ${sp(tot)}이지만, 이 중 <b>${man(nw)}원</b>은 전년 같은 기간에 존재하지 않던 신규 지면에서 나왔습니다
(기여 <span class="up">+${(nw/L[1]*100).toFixed(1)}%p</span>). 전년에도 있던 지면만 놓고 보면 <b>${sp(lf)}</b>입니다.`;
}else el.style.display='none';
}
function mLever(){
const P=MP(),i=mIdx,y=i-mOff();
const box=document.getElementById('mLever'),fx=document.getElementById('mFactors');
if(y<0||!mv(P.t[y],0)){box.innerHTML='<p class="sub">비교 기간 데이터가 없어 분해할 수 없습니다.</p>';fx.innerHTML='';return;}
const c=P.t[i],b=P.t[y],dc=P.d[i],db=P.d[y];
const D0=db[0]*db[1],D1=dc[0]*dc[1];
const Q0=mv(b,2)/D0,Q1=mv(c,2)/D1;
const F0=mIr(b)/100,F1=mIr(c)/100;
const E0=mEc(b)/1000,E1=mEc(c)/1000;
const dD=(D1-D0)*Q0*F0*E0, dQ=D1*(Q1-Q0)*F0*E0, dF=D1*Q1*(F1-F0)*E0, dE=D1*Q1*F1*(E1-E0);
const tot=mv(c,0)-mv(b,0);
bars(box,[['앱 DAU',dD,'#3987E5'],['인당 요청수',dQ,'#1F8B5F'],['게재율',dF,'#8A9099'],['eCPM',dE,'#CC4B3E']],tot);
const C=[
{n:'요인 1',c:'#3987E5',t:'트래픽(앱 DAU)',v:won(dD),
p:`${(db[0]/10000).toFixed(1)}만 → ${(dc[0]/10000).toFixed(1)}만 (${(pct(dc[0],db[0])||0)>=0?'+':''}${(pct(dc[0],db[0])||0).toFixed(1)}%). 매출 이전에 사용자 기반이 어떻게 움직였는지입니다.`},
{n:'요인 2',c:'#1F8B5F',t:'인당 요청수',v:won(dQ),
p:`1인 1일 ${Q0.toFixed(1)}회 → ${Q1.toFixed(1)}회 (${(pct(Q1,Q0)||0)>=0?'+':''}${(pct(Q1,Q0)||0).toFixed(1)}%). 지면 신설·노출 빈도 확대가 여기에 잡힙니다.`},
{n:'요인 3',c:'#8A9099',t:'게재율',v:won(dF),
p:`${(F0*100).toFixed(1)}% → ${(F1*100).toFixed(1)}%. 요청을 늘려도 채우지 못하면 여기서 새어 나갑니다.`},
{n:'요인 4',c:'#CC4B3E',t:'단가(eCPM)',v:won(dE),
p:`${Math.round(E0*1000)}원 → ${Math.round(E1*1000)}원 (${(pct(E1,E0)||0)>=0?'+':''}${(pct(E1,E0)||0).toFixed(1)}%). 물량이 아니라 값 자체가 오르내린 몫입니다.`}];
fx.innerHTML=C.map(x=>`<div class="fc"><div class="n" style="color:${x.c}">${x.n}</div><h5>${x.t}</h5>
<div class="v" style="color:${x.c}">${x.v}</div><p>${x.p}</p></div>`).join('');
}
function mCell(arr,off,noC){
const P=MP(),i=mIdx,j=i-off;
const cv=mv(arr[i],0), b=j>=0?arr[j]:null, bv=b?mv(b,0):0;
if(bv<1000&&cv>=1000)return '<span class="chip">신규</span>';
if(bv>=1000&&cv<1000)return '<span class="chip x">종료</span>';
if(!(bv>=1000&&cv>=1000))return '<span style="color:#8A9099">—</span>';
const tb=mv(P.t[j],0)*mSc(i,j);
const df=cdif(cv,bv,i,j), ct=tb?df/tb*100:null;
const co=noC||ct==null?'':` · 기여 ${(ct>=0?'+':'')+ct.toFixed(1)}%p`;
return `<span class="p">${sp(cpct(cv,bv,i,j))}</span><span class="s">${df>=0?'+':'-'}${man(Math.abs(df))}${co}</span>`;
}
function mRow(name,arr,src,mut){
const i=mIdx,y=i-mOff(),c=arr[i],ba=y>=0?arr[y]:null,bav=ba?mv(ba,0):0,A=mCmp==='mom',nc=src==='t';
return `<tr class="hd mh" data-k="${name}" data-s="${src}"><td><span>▸</span></td><td>${name}</td>
<td>${man(mv(c,0))}원</td>
<td class="d2${A?' act':''}">${mCell(arr,1,nc)}</td>
<td class="d2${A?'':' act'}${mut?' mut':''}">${mCell(arr,12,nc)}</td>
<td>${ba&&bav?Math.round(mEc(ba))+' → ':''}${Math.round(mEc(c))}원</td>
<td>${ba&&bav?mIr(ba).toFixed(1)+' → ':''}${mIr(c).toFixed(1)}%</td></tr>`;
}
function mFill(){
const P=MP();
document.getElementById('mtG').innerHTML=GK.map(k=>mRow(k,P.g[k],'g')).join('')
+mRow('합계',P.t,'t').replace('class="hd mh"','class="hd mh tot"');
// 네트워크는 당월 매출 내림차순 — 종료된 곳은 0원이라 자연히 아래로 간다
const nk=MO.NK.slice().sort((x,z)=>mv(P.n[z][mIdx],0)-mv(P.n[x][mIdx],0));
document.getElementById('mtN').innerHTML=nk.map(k=>mRow(k,P.n[k],'n',1)).join('')
+mRow('합계',P.t,'t',1).replace('class="hd mh"','class="hd mh tot"');
document.querySelectorAll('tr.mh').forEach(tr=>tr.onclick=()=>mExpand(tr));
}
const MMET=[['rev','매출','#D9873F',v=>man(v)],['ecpm','eCPM','#2FA36B',v=>Math.round(v)+'원'],
['ir','게재율','#3987E5',v=>v.toFixed(1)+'%']];
function mSeries(arr,key,a,b){const o=[];for(let i=a;i<=b;i++){const x=arr[i];
o.push(key==='ecpm'?mEc(x):key==='ir'?mIr(x):mv(x,0));}return o;}
function mExpand(tr){
const nx=tr.nextElementSibling;
if(nx&&nx.classList.contains('ex')){nx.remove();tr.classList.remove('op');return;}
document.querySelectorAll('#pM tr.ex').forEach(r=>r.remove());
document.querySelectorAll('#pM tr.hd.op').forEach(r=>r.classList.remove('op'));
tr.classList.add('op');
const P=MP(),key=tr.dataset.k,sc=tr.dataset.s;
const arr=sc==='t'?P.t:sc==='g'?P.g[key]:P.n[key];
const r=document.createElement('tr');r.className='ex';
r.innerHTML=`<td colspan="7"><div class="exb"><div class="exh"><span class="t">${key} · 월별 추이 <span style="font-weight:400;color:#8A9099">(${MCUR()?'각 월 1~'+MO.cd+'일 누적 기준':'각 월 전체'})</span></span>
<span class="grp">${MMET.map((m,i)=>`<button class="pill${i?'':' on'}" data-m="${m[0]}">${m[1]}</button>`).join('')}</span></div>
<div class="bc"></div><div class="st"></div></div></td>`;
tr.after(r);
const bc=r.querySelector('.bc'),stx=r.querySelector('.st');
let mk='rev';
const draw=()=>{const b=MLAST,a=mSpan?Math.max(0,b-mSpan+1):0;
const v=mSeries(arr,mk,a,b),M=MMET.find(x=>x[0]===mk),L=[];
for(let i=a;i<=b;i++)L.push(mLab(MO.m[i]));
const n=v.length;
chart(bc,v,{W:880,H:235,col:M[2],fmt:M[3],lab:L,step:Math.max(1,Math.round(n/8)),area:true,name:`${key} ${M[1]}`});
const last=v[n-1],yy=n>12?v[n-13]:null,pos=v.filter(x=>x>0);
stx.innerHTML=`<span>최근 <b>${M[3](last)}</b> <span style="color:#8A9099">(${MO.m[b]}${b===MLAST?' 진행중':''})</span></span>
<span>전월 대비 ${sp(pct(last,v[n-2]))}</span><span>전년 동월 대비 ${yy!=null?sp(pct(last,yy)):'—'}</span>
<span>최고 <b>${M[3](Math.max(...v))}</b> · 최저 <b>${M[3](pos.length?Math.min(...pos):0)}</b></span>`;};
draw();
r.querySelectorAll('.exh .pill[data-m]').forEach(b=>b.onclick=e=>{e.stopPropagation();
r.querySelectorAll('.exh .pill[data-m]').forEach(x=>x.classList.remove('on'));b.classList.add('on');mk=b.dataset.m;draw();});
}
const MTR={rev:['매출','#D9873F',v=>man(v)],arp:['ARPDAU','#2FA36B',v=>'₩'+v.toFixed(2)],
dau:['앱 DAU','#3987E5',v=>(v/10000).toFixed(0)+'만'],ecpm:['eCPM','#C87A2E',v=>Math.round(v)+'원']};
const ma7=a=>a.map((_,i)=>{let s=0,c=0;for(let j=Math.max(0,i-6);j<=i;j++){if(a[j]!=null){s+=a[j];c++;}}return c>=4?s/c:null;});
const AM={dau:['앱 DAU','#3987E5'],rev:['네트워크 매출','#2FA36B'],arp:['ARPDAU','#D9873F']};
let mSer={dau:true,rev:true,arp:true};
function mChart(){
const C0=MO.c0||'2026-01-01', ALL=mTrend==='all';
const L=[], SS={rev:[],dau:[],arp:[],ecpm:[]};
let proj=false, live=false, note='';
if(mWin==='m'){
const F=MO.F, m0=Math.max(0,MO.m.findIndex(x=>x>=C0.slice(0,7)));
for(let i=m0;i<=MLAST;i++){
L.push(mLab(MO.m[i]));
const t=F.t[i], d=F.d[i];
SS.rev.push(mv(t,0)); SS.dau.push(d[0]); SS.ecpm.push(mEc(t));
SS.arp.push(d[0]&&d[1]?mv(t,0)/d[0]/d[1]:0);
}
// 진행 중인 달 — 매출만 누적합이라 1~N일치를 그대로 찍으면 급락처럼 보인다.
// 예상치는 대시보드 E.EOD와 **같은 값**이다(build_data.py 가 계산해 MO.eod 로 넘겨준다).
const est=(MO.eod&&MO.eod.est)?MO.eod.est:null;
const drop=()=>{L.pop();for(const k in SS)SS[k].pop();};
if(ALL){   // 지수 3선에 예상치를 섞으면 읽는 사람이 실적으로 오해한다
drop(); note=`진행 중인 ${mLab(MO.m[MLAST])}는 누적 매출이 섞여 지수를 왜곡하므로 뺐습니다.`;
}else if(mTrend==='rev'){
if(est){SS.rev[SS.rev.length-1]=est; proj=true;
const E=MO.eod||{};
note=`마지막 ${mLab(MO.m[MLAST])}는 점선 · 속 빈 점으로 표시한 월마감 예상(${man(est)}원)입니다 — 실적은 ${E.last||MO.ls}까지 ${man(E.act||0)}원이고, 전년 동월의 날짜별 분포에 공휴일 보정을 걸어 남은 기간을 채운 값입니다. 대시보드 ARPDAU 탭의 E.EOD와 같은 값입니다.`;}
else {drop(); note='전년 동월 데이터가 없어 진행 중인 달은 뺐습니다.';}
}else{
live=true;
note=`마지막 ${mLab(MO.m[MLAST])}는 ${MO.ls}까지 ${MO.cd}일 평균입니다(속 빈 점) — 평균·비율 지표라 부분 월도 그대로 비교됩니다.`;
}
}
else if(mWin==='w'){
const g=W.grp['합계'];
for(let i=0;i<NW;i++){
if(W.wkEnd[i]<C0) continue;
L.push(W.wkEnd[i].slice(5).replace('-','/'));
const rv=S(g,'수익',i), im=S(g,'노출수',i), du=W.dau[i];
SS.rev.push(rv); SS.dau.push(du);
SS.ecpm.push(im?rv/im*1000:0); SS.arp.push(du?rv/du/7:0);
}
note='주 단위(월~일)입니다. 완전한 주만 그리므로 이번 주 진행분은 빠져 있습니다. 라벨은 그 주의 마지막 날(일요일)입니다.';
}
else{
const d0=new Date(W.d0+'T00:00:00');
for(let i=0;i<W.dd.length;i++){
const dt=new Date(d0); dt.setDate(dt.getDate()+i);
const ds=ymd(dt); if(ds<C0) continue;
L.push(ds.slice(5).replace('-','/'));
const rv=W.dd[i], im=W.di[i]||0, du=W.du[i];
SS.rev.push(rv); SS.dau.push(du);
SS.ecpm.push(im?rv/im*1000:0); SS.arp.push(du?rv/du:0);
}
note = ALL
? `일 단위 원본에 7일 이동평균을 씌웠습니다(${MO.ls}까지, D-2 캐던스) — 세 선을 그대로 겹치면 전부 톱니가 되어 읽을 수 없습니다.`
: `일 단위 원본입니다(${MO.ls}까지, D-2 캐던스). 주말 하락 같은 요일 효과가 그대로 보이므로 추세 판단에는 1주·1개월 단위를 씁니다.`;
}
const el=document.getElementById('mChart'), lg=document.getElementById('mLeg');
const step=Math.max(1,Math.round(L.length/8));
const WN={d:'일별',w:'주별',m:'월별'}[mWin];
if(ALL){
// 단위가 다른 세 지표를 겹치려면 지수화가 필요하다. 일 단위는 요일 효과로 세 선이
// 전부 톱니가 되어 읽을 수 없으므로 7일 이동평균을 씌운다.
const nm=x=>{const b=x.find(v=>v!=null&&v>0)||1;return x.map(v=>v==null?null:v/b*100);};
const sm=x=>mWin==='d'?ma7(x):x;
const on=['dau','rev','arp'].filter(k=>mSer[k]);
chart(el,null,{H:250,lab:L,step,multi:on.map(k=>[AM[k][0],sm(nm(SS[k])),AM[k][1]]),fmt:v=>Math.round(v)});
lg.style.display='';
lg.innerHTML=['dau','rev','arp'].map(k=>
`<span data-s="${k}" class="${mSer[k]?'':'off'}" title="클릭해서 켜고 끄기"><i style="background:${AM[k][1]}"></i>${AM[k][0]}</span>`).join('')
+`<span style="color:#8A9099">첫 시점=100 지수${mWin==='d'?' · 7일 평균':''}</span>`;
lg.querySelectorAll('span[data-s]').forEach(sp=>sp.onclick=()=>{
const k=sp.dataset.s;
if(mSer[k]&&['dau','rev','arp'].filter(x=>mSer[x]).length<=1)return;   // 마지막 한 선은 못 끈다
mSer[k]=!mSer[k];mChart();});
document.getElementById('mChartTitle').textContent=`${WN} DAU · 매출 · ARPDAU 추이`;
note='세 지표를 첫 시점 100으로 맞춘 지수입니다 — 절대값이 아니라 **벌어지는 정도**를 봅니다. 범례를 눌러 선을 끄고 켤 수 있습니다. '+note;
}else{
lg.style.display='none';
const M=MTR[mTrend];
chart(el,SS[mTrend],{H:250,col:M[1],fmt:M[2],lab:L,step,area:true,name:M[0],proj:proj,live:live});
document.getElementById('mChartTitle').textContent=`${WN} ${M[0]} 추이`;
}
document.getElementById('mChartNote').textContent=
`${C0.slice(0,7).replace('-','년 ')}월부터 표시합니다 — 2025년은 지면·네트워크 라인업이 달라 같은 선에 두지 않습니다. `
+ note.replace(/\*\*/g,'');
}
function mRender(){
const CM=mCmp==='mom', L=CM?'전월 동기':'전년 동기';
document.getElementById('mTitle').textContent=`월 누적 지표 · ${L} 대비`;
document.getElementById('mLvTitle').textContent=`${L} 대비 증감 분해`;
const vh=MCUR()?'MTD 매출':'월 매출';
document.getElementById('mhV').textContent=vh;
document.getElementById('mhV2').textContent=vh;
document.querySelectorAll('th.cmp').forEach(t=>t.classList.toggle('act',(t.dataset.c==='mom')===CM));
mTiles();mLever();mFill();mChart();
}
function setAxis(a){
axis=a;
const M=(a==='m'||a==='y');
document.getElementById('pM').style.display=M?'':'none';
['pW','pW2'].forEach(id=>document.getElementById(id).style.display=a==='w'?'':'none');
if(M){mCmp=(a==='m')?'mom':'yoy';mRender();}
document.getElementById('axNote').textContent = a==='m'
? '전월 동기 대비는 방학·개강·시험 등 학사일정이 그대로 섞입니다 — 추세 판단은 전년 동기 탭과 같이 보세요.'
: a==='y'
? '시즌성을 걷어낸 축입니다. 다만 전년에 없던 신규 지면이 섞이므로 동일 지면 기준을 같이 보세요.'
: '주간 축은 최근 4주 내 적용한 변경의 즉시 효과를 확인할 때만 사용하세요. 개강·시험·방학 영향이 그대로 섞입니다.';
document.querySelectorAll('.pill.ax').forEach(b=>b.classList.toggle('on',b.dataset.ax===a));
}
const sel=document.getElementById('selWk');
sel.innerHTML=W.wkEnd.map((e,i)=>{const st=new Date(e+'T00:00:00');st.setDate(st.getDate()-6);
return `<option value="${i}">${ymd(st).replace(/-/g,'.').slice(2)} ~ ${e.replace(/-/g,'.').slice(2)}</option>`;}).reverse().join('');
sel.value=cur;
function render(){tiles();fill();drawLever();}
sel.onchange=()=>{cur=+sel.value;render();};
document.getElementById('btnLast').onclick=()=>{cur=NW-1;sel.value=cur;render();};
const msel=document.getElementById('selMo');
msel.innerHTML=MO.m.map((m,i)=>`<option value="${i}">${m}${i===MLAST?' (진행중 · '+MO.cd+'일)':''}</option>`).reverse().join('');
msel.value=mIdx;
msel.onchange=()=>{mIdx=+msel.value;mRender();};
document.getElementById('btnMoLast').onclick=()=>{mIdx=MLAST;msel.value=mIdx;mRender();};
document.querySelectorAll('#moTrend .pill').forEach(b=>b.onclick=()=>{
document.querySelectorAll('#moTrend .pill').forEach(x=>x.classList.remove('on'));b.classList.add('on');
mTrend=b.dataset.mt;mChart();});
document.querySelectorAll('#moWin .pill').forEach(b=>b.onclick=()=>{
document.querySelectorAll('#moWin .pill').forEach(x=>x.classList.remove('on'));b.classList.add('on');
mWin=b.dataset.mw;mChart();});
document.querySelectorAll('.pill.ax').forEach(b=>b.onclick=()=>setAxis(b.dataset.ax));
render();setAxis('m');
</script></body></html>